APP_NAME="Omni POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# NativePHP thin wrapper (goal 2): the desktop shell opens this URL in a
# kiosk window. Must be reachable from the machine running the app. Defaults
# to https://192.168.31.88 (the LAN host) when unset. NATIVE_KIOSK=true for
# fullscreen kiosk mode.
NATIVE_APP_URL=https://192.168.31.88
NATIVE_KIOSK=false

# Low-stock alert/reorder threshold (config/pos.php). Alerts fire when on
# hand drops to this level or below; the products table highlights the row.
LOW_STOCK_THRESHOLD=10

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Both default to ON when these keys are absent (config/telescope.php uses
# env('TELESCOPE_ENABLED', true); Debugbar falls back to APP_DEBUG), and each
# adds roughly 0.5-1.5s per request. Flip to true only while actively
# debugging, then flip back.
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

# Hosts are Docker service names from compose.yaml — the whole stack runs in containers.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Self-hosted S3-compatible bucket (MinIO container) for product/category/company images.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=pos-images
MINIO_ENDPOINT=http://minio:9000
MINIO_URL=http://localhost:9000/pos-images

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=elastic
SCOUT_QUEUE=true
ELASTIC_HOST=elasticsearch

# Host-side forwarded ports (avoid clashing with local services)
FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6380
FORWARD_ELASTICSEARCH_PORT=9200
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=9001

REVERB_APP_ID=100001
REVERB_APP_KEY=omnipos_reverb_key
REVERB_APP_SECRET=omnipos_reverb_secret
# Backend containers publish events to the reverb service over the Docker network
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# The browser connects to Reverb via the published localhost port
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
