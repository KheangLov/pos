# Production environment template — copy to .env.production and fill in.
#
# This file ships with the release. `.env.production` itself must NOT be
# committed or included in a release archive; it holds this site's secrets.
#
# Anything marked CHANGE ME is a real secret: generate a fresh value per
# customer site. Reusing one set of credentials across every install means one
# leaked deployment compromises them all.

APP_NAME="Omni POS"
APP_ENV=production
# Generate once per site: docker compose -f compose.prod.yaml run --rm app php artisan key:generate --show
APP_KEY=                                  # CHANGE ME
APP_DEBUG=false
# The LAN address staff and customer phones will actually use. `localhost`
# only works on the server itself — a phone scanning a table QR code needs the
# host machine's LAN IP (or a hostname that resolves to it).
APP_URL=http://192.168.1.10:8000          # CHANGE ME
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` would write request payloads to disk on a machine you don't control.
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=omnipos
DB_USERNAME=omnipos
DB_PASSWORD=                              # CHANGE ME

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Image storage (MinIO container)
MINIO_ROOT_USER=omnipos                   # CHANGE ME
MINIO_ROOT_PASSWORD=                      # CHANGE ME
MINIO_BUCKET=pos-images
MINIO_ENDPOINT=http://minio:9000
MINIO_PORT=9000
# Must match APP_URL's host — browsers load product images straight from here.
MINIO_URL=http://192.168.1.10:9000/pos-images   # CHANGE ME

SCOUT_DRIVER=elastic
SCOUT_QUEUE=true
ELASTIC_HOST=elasticsearch

REVERB_APP_ID=                            # CHANGE ME (any 6-digit number)
REVERB_APP_KEY=                           # CHANGE ME (random string)
REVERB_APP_SECRET=                        # CHANGE ME (random string)
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Baked into the frontend bundle at build time. VITE_REVERB_HOST is read from
# window.location at runtime instead (see resources/js/echo.js), so it does not
# need the LAN IP here.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Licensing -------------------------------------------------------------
# Public half of your vendor signing key (php artisan license:keygen). Safe to
# ship: it can verify licences but never create them. The SECRET key must never
# appear in this file or anywhere on a customer machine.
LICENSE_PUBLIC_KEY=                       # CHANGE ME
LICENSE_ENFORCE=true
LICENSE_WARN_DAYS=14
LICENSE_GRACE_DAYS=7
LICENSE_VENDOR="Omni POS"
LICENSE_SUPPORT_EMAIL=
LICENSE_SUPPORT_PHONE=

# --- Never enable on a customer machine ------------------------------------
# Telescope and Debugbar are dev dependencies and are absent from release
# builds; these are here only as a reminder that they expose request payloads,
# queries and source paths.
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
